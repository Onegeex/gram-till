# Copy to .env and fill in. Never commit .env.
NETWORK=testnet                 # testnet (demo) or mainnet (watch a real Gram Wallet, read-only)
PORT=8787
PUBLIC_URL=http://localhost:8787 # set to your https tunnel/host so Telegram Pay buttons work
TONCENTER_API_KEY=              # free key from @tonapibot (pick testnet for testnet)
TELEGRAM_BOT_TOKEN=             # from @BotFather
GROQ_API_KEY=                   # https://console.groq.com (Whisper speech-to-text)
TILL_TIMEZONE=UTC              # default day boundary; each seller can set their own with /timezone
MAX_CHARGE_GRAM=500
DEV_SIMULATE=0                  # 1 = enable /dev/pay/<code> fake payments (testnet only, for UI work)
